<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootPane" focusTraversable="true" styleClass="root-pane" prefWidth="1100.0" prefHeight="700.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.flow.controller.MainController">
   <children>
      <!-- Main Game Canvas -->
      <Canvas fx:id="gameCanvas" width="1100.0" height="700.0" focusTraversable="true" />

      <!-- Main Menu Overlay (Redesigned 2D Indie Game Interface) -->
      <VBox fx:id="menuOverlay" alignment="CENTER" spacing="14.0" styleClass="menu-overlay">
         <children>
            <!-- Title Box -->
            <VBox alignment="CENTER" spacing="4.0" styleClass="title-box">
               <children>
                  <Label text="FLOW: FLOODED IUT CAMPUS" styleClass="game-title" />
                  <Label text="MISSION BRIEFING :: SECTOR 01" styleClass="mission-briefing" />
                  <Label text="VISUAL PROGRAMMING LAB // 2-PLAYER LOCAL CO-OP DEPLOYMENT" styleClass="mission-sub" />
               </children>
            </VBox>

            <!-- Player 1 & Player 2 Tactical Cards -->
            <HBox alignment="CENTER" spacing="20.0" maxWidth="900.0">
               <children>
                  <!-- Player 1 Panel -->
                  <VBox prefWidth="420.0" spacing="8.0" styleClass="player-panel-p1">
                     <children>
                        <Label text="TACTICAL PILOT // PLAYER 1" styleClass="panel-header-p1" />
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                           <children>
                              <Label text="STEER:" styleClass="tech-meta" />
                              <Label text="W" styleClass="keycap" />
                              <Label text="A" styleClass="keycap" />
                              <Label text="S" styleClass="keycap" />
                              <Label text="D" styleClass="keycap" />
                              <Label text="VEHICLE:" styleClass="tech-meta" style="-fx-padding: 0 0 0 8px;" />
                              <Label text="V" styleClass="keycap-highlight" />
                              <Label text="AIRDROP:" styleClass="tech-meta" style="-fx-padding: 0 0 0 4px;" />
                              <Label text="H" styleClass="keycap-highlight" />
                           </children>
                        </HBox>
                        <Label text="Navigate flooded campus avenues. Control boat, 6x6 land buggy &amp; rescue helicopter." styleClass="mission-sub" wrapText="true" />
                     </children>
                  </VBox>

                  <!-- Player 2 Panel -->
                  <VBox prefWidth="420.0" spacing="8.0" styleClass="player-panel-p2">
                     <children>
                        <Label text="RESCUE CREW // PLAYER 2" styleClass="panel-header-p2" />
                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                           <children>
                              <Label text="OPERATE:" styleClass="tech-meta" />
                              <Label text="↑" styleClass="keycap" />
                              <Label text="←" styleClass="keycap" />
                              <Label text="↓" styleClass="keycap" />
                              <Label text="→" styleClass="keycap" />
                              <Label text="ROPE:" styleClass="tech-meta" style="-fx-padding: 0 0 0 4px;" />
                              <Label text="SPACE/R" styleClass="keycap-highlight" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="5.0">
                           <children>
                              <Label text="TRIAGE &amp; FEED:" styleClass="tech-meta" />
                              <Label text="F" styleClass="keycap" />
                              <Label text="FEED MEAL" styleClass="tech-meta" />
                              <Label text="T" styleClass="keycap" />
                              <Label text="TREAT INJURY" styleClass="tech-meta" />
                           </children>
                        </HBox>
                        <Label text="Aim &amp; deploy rope lasso to air-lift survivors. Triage injuries &amp; serve meal cravings." styleClass="mission-sub" wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Difficulty Selection -->
            <VBox alignment="CENTER" spacing="8.0">
               <children>
                  <Label text="RESCUE MISSION // SELECT OPERATION DIFFICULTY" styleClass="difficulty-title" />
                  <HBox alignment="CENTER" spacing="12.0">
                     <children>
                        <Button focusTraversable="false" text="💙 COZY&#10;Relaxed Patrol" onAction="#onSelectCozy" styleClass="diff-btn, diff-btn-cozy" textAlignment="CENTER" />
                        <Button focusTraversable="false" text="🟢 EASY&#10;Standard Patrol · 8 Target" onAction="#onSelectEasy" styleClass="diff-btn, diff-btn-easy" textAlignment="CENTER" />
                        <Button focusTraversable="false" text="🟡 MEDIUM&#10;Heavy Surge · 12 Target" onAction="#onSelectMedium" styleClass="diff-btn, diff-btn-medium" textAlignment="CENTER" />
                        <Button focusTraversable="false" text="🔴 HARD&#10;Red Alert · 18 Target" onAction="#onSelectHard" styleClass="diff-btn, diff-btn-hard" textAlignment="CENTER" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- Technical Metadata & Map Zoom Hints -->
            <VBox alignment="CENTER" spacing="2.0">
               <children>
                  <Label text="MAP ZOOM: [ Q ] / [ E ] OR MOUSE SCROLL   |   CHAIN RESCUES FOR COMBO MULTIPLIER" styleClass="tech-meta" />
                  <Label text="COORDINATES: 23°56'52&quot;N 90°22'43&quot;E  |  FLOOD STAGE IV  |  IUT CAMPUS SECTOR 01" styleClass="mission-sub" />
               </children>
            </VBox>

            <!-- Quit Button -->
            <Button focusTraversable="false" text="[ X ]  ABORT / QUIT MISSION" onAction="#onQuitGame" styleClass="quit-btn" />
         </children>
      </VBox>

      <!-- Game Over Overlay -->
      <VBox fx:id="gameOverOverlay" alignment="CENTER" spacing="20.0" style="-fx-background-color: rgba(6, 17, 31, 0.96); -fx-padding: 40px;" visible="false">
         <children>
            <Label text="⚓ IUT CAMPUS EVACUATION FAILED!" textFill="#d83a3a" styleClass="game-title" />
            <Label text="Too many survivors perished before reaching the evacuation goal. Select a lower difficulty!" styleClass="mission-sub" />
            <HBox alignment="CENTER" spacing="16.0">
               <children>
                  <Button focusTraversable="false" text="RETRY RESCUE MISSION" onAction="#onStartGame" styleClass="diff-btn, diff-btn-hard" />
                  <Button focusTraversable="false" text="[ X ]  QUIT MISSION" onAction="#onQuitGame" styleClass="quit-btn" />
               </children>
            </HBox>
         </children>
      </VBox>

      <!-- Victory Overlay -->
      <VBox fx:id="victoryOverlay" alignment="CENTER" spacing="20.0" style="-fx-background-color: rgba(6, 17, 31, 0.96); -fx-padding: 40px;" visible="false">
         <children>
            <Label text="🏆 IUT EVACUATION SUCCESSFUL! ALL RESCUED!" textFill="#31a85b" styleClass="game-title" />
            <Label text="Outstanding co-op teamwork! Evacuation goal reached — every survivor fed, treated, and delivered!" styleClass="mission-sub" />
            <HBox alignment="CENTER" spacing="16.0">
               <children>
                  <Button focusTraversable="false" text="START NEW EXPEDITION" onAction="#onStartGame" styleClass="diff-btn, diff-btn-easy" />
                  <Button focusTraversable="false" text="[ X ]  QUIT MISSION" onAction="#onQuitGame" styleClass="quit-btn" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
